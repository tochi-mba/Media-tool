# Copy to .env for local development. Every setting has a working default -- this file
# exists to show the shape, not because anything here is required.
# Full reference: docs/operations.md

# --- Identity and logging ---------------------------------------------------------
MEDIA_TOOL_ENVIRONMENT=local
MEDIA_TOOL_LOG_LEVEL=INFO
# json in deployment, console for readable local output
MEDIA_TOOL_LOG_FORMAT=console

# --- Serving ----------------------------------------------------------------------
MEDIA_TOOL_HOST=127.0.0.1
MEDIA_TOOL_PORT=8000

# --- Which provider does the work -------------------------------------------------
# stub    fabricates a real file; needs no browser. The default.
# browser drives headless Chromium through a site recipe. Requires RECIPE_PATH.
MEDIA_TOOL_PROVIDER=stub
# MEDIA_TOOL_RECIPE_PATH=recipes/example.json

# --- Work limits ------------------------------------------------------------------
MEDIA_TOOL_MAX_ITEMS_PER_REQUEST=50
MEDIA_TOOL_DOWNLOAD_CONCURRENCY=4
MEDIA_TOOL_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_TOOL_MAX_ATTEMPTS=3
MEDIA_TOOL_BACKOFF_BASE_SECONDS=0.5
MEDIA_TOOL_BACKOFF_MAX_SECONDS=8

# --- Storage and retention --------------------------------------------------------
MEDIA_TOOL_ARTIFACT_DIR=var/artifacts
MEDIA_TOOL_MAX_FILE_BYTES=2147483648
MEDIA_TOOL_JOB_TTL_SECONDS=3600
MEDIA_TOOL_ARTIFACT_TTL_SECONDS=3600
MEDIA_TOOL_JOB_SWEEP_INTERVAL_SECONDS=60

# --- Browser (nested settings use a double underscore) ----------------------------
MEDIA_TOOL_BROWSER__HEADLESS=true
# Set when the installed Playwright is newer than the available Chromium build.
# Passing an explicit path also bypasses Playwright's revision check.
# MEDIA_TOOL_BROWSER__EXECUTABLE_PATH=/opt/pw-browsers/chromium
MEDIA_TOOL_BROWSER__MAX_PAGES=2
MEDIA_TOOL_BROWSER__NAVIGATION_TIMEOUT_MS=15000
MEDIA_TOOL_BROWSER__ACTION_TIMEOUT_MS=10000
MEDIA_TOOL_BROWSER__DOWNLOAD_TIMEOUT_MS=120000
# A saved Playwright session, for sites that need a login.
# MEDIA_TOOL_BROWSER__STORAGE_STATE_PATH=var/session.json
